/*
 * The EVM Interpreter was deployed at deterministic address using the `create2` method from the Universal Factory,
 * once solidity's version can change the `Intepreter.sol` creation code, the constants below are useful to deploy
 * the interpreter at a deterministic address in any network that also contains the Universal Factory Contract.
 *
 * The interpreter can be easily deployed as demonstrated below:
 * ```solidity
 * import {IUniversalFactory} from "universal-factory/src/interfaces/IUniversalFactory.sol";
 * import {INTERPRETER_ADDRESS, INTERPRETER_CREATE2_SALT, INTERPRETER_CREATION_CODE} from "evm-interpreter/src/utils/Constants.sol";
 * 
 * IUniversalFactory factory = IUniversalFactory(0x0000000000001C4Bf962dF86e38F0c10c7972C6E);
 * address interpreter = factory.create2(INTERPRETER_CREATE2_SALT, INTERPRETER_CREATION_CODE);
 * require(interpreter == INTERPRETER_ADDRESS);
 * ```
 *
 * For more information on how to use the Universal Factory, see:
 * - https://github.com/Analog-Labs/universal-factory
 */
pragma solidity >=0.7.0 <0.9.0;

/**
 * @dev The address of UniversalFactory, which deployed this contract using the `create2` method.
 */
address constant INTERPRETER_CREATE2_DEPLOYER = 0x0000000000001C4Bf962dF86e38F0c10c7972C6E;

/**
 * @dev EIP-1014 CREATE2 salt used to deploy the interpreter.
 * reference: https://eips.ethereum.org/EIPS/eip-1014
 */
bytes32 constant INTERPRETER_CREATE2_SALT = 0xc8530e31f6ca0170eadd291ef7444560d457094dc3888d929e3cd76bcd4acf7f;

/**
 * @dev The address of which the Interpreter was deployed, can be computed as:
 * `address(uint160(uint256(keccak256(abi.encodePacked(bytes1(0xff), INTERPRETER_CREATE2_DEPLOYER, INTERPRETER_CREATE2_SALT, INTERPRETER_INITCODE_HASH)))))`.
 */
address constant INTERPRETER_ADDRESS = 0x0000000000001e3F4F615cd5e20c681Cf7d85e8D;

/**
 * @dev The codehash of the Interpreter, must be the same regardless the address or solidity version.
 */
bytes32 constant INTERPRETER_CODEHASH = 0xaa65624ae6c78a7f070d28f3aa36674e5c835a708ad1422a45530c18d83b725e;

/**
 * @dev The hash of the initicode.
 * INTERPRETER_INITCODE_HASH == keccak256(INTERPRETER_CREATION_CODE);
 */
bytes32 constant INTERPRETER_INITCODE_HASH = 0x9fbdeb778ae8c9daa6db3f5c8d55d2c4bbaba059382891af1cbac6562f88bbe5;

/**
 * @dev This is the `type(Interpreter).creationCode` used to deploy the interpreter at the `INTERPRETER_ADDRESS`.
 * defined as a constant to allow it to be deployed at the same address using different solidity versions.
 */
bytes constant INTERPRETER_CREATION_CODE =
    hex"";
